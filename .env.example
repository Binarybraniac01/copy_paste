# Browser-safe: available from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_NORMAL_ORIGIN=http://localhost:3000
NEXT_PUBLIC_ISOLATED_ORIGIN=http://localhost:3000
# Server-only: never prefix this with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PAD_TTL_MINUTES=60
MAX_PAD_SIZE_BYTES=1048576
